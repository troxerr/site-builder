# Content-hashed files never change under the same name
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Other files keep their names, so a replaced image can take up to a week to refresh
/assets/work/*
  Cache-Control: public, max-age=604800
/assets/og/*
  Cache-Control: public, max-age=604800
/assets/stock/*
  Cache-Control: public, max-age=604800
/assets/fonts/*
