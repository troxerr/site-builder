# Cloudflare Workers static assets: response headers by path.
# Matching rules add up (the same header from two rules is joined), and "! Name" removes one an earlier rule set.
# HTML needs no Cache-Control here: the host revalidates it by default.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: SAMEORIGIN

# Content-Security-Policy for OUR pages only, listed one by one on purpose: each demo under /demos/ is a self-contained site that uses
# inline styles and Google Fonts, and Cloudflare does not reliably let a later rule remove a header, so the policy must never be set on /*.
# Nothing loads from other sites except Cloudflare's analytics beacon and the Web3Forms post. Our pages have no inline scripts;
# script-src allows 'unsafe-inline' only because Cloudflare injects its own inline bot-detection script on some pages. Styles stay strict.
/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com https://cloudflareinsights.com; form-action 'self' https://api.web3forms.com; base-uri 'self'; object-src 'none'; frame-ancestors 'self'
